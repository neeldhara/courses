---
import { courseRoutes } from '@/shared/config/courseRouting';
import DocsLandingLayout from "@/docs/layouts/DocsLandingLayout.astro";

export async function getStaticPaths() {
  return Object.keys(courseRoutes).map((courseId) => ({
    params: { course: courseId },
    props: { 
      courseInfo: courseRoutes[courseId as keyof typeof courseRoutes]
    },
  }));
}

const { course } = Astro.params;
const { courseInfo } = Astro.props;
---

<DocsLandingLayout title={`${courseInfo.name} | Neeldhara's Courses`} description={`${courseInfo.name} - ${courseInfo.type} course`}>
  <main>
    <div class="container mx-auto px-4 py-16">
      <div class="text-center mb-12">
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-medium mb-4 text-purple-600 dark:text-purple-400">
          {courseInfo.name}
        </h1>
        <div class="inline-block px-4 py-2 bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300 rounded-full text-sm font-medium mb-6">
          {courseInfo.type}
        </div>
        <div class="text-2xl mb-6 text-gray-600 dark:text-gray-400">
          🚧 Coming Soon 🚧
        </div>
        <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          This course website is currently under development. <br /> Check back soon for updates!
        </p>
      </div>

      <div class="max-w-4xl mx-auto mb-12">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8 border border-gray-200 dark:border-gray-700">
          <h3 class="font-heading text-2xl font-medium mb-6 text-gray-800 dark:text-gray-200">
            What to expect:
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-4">
              <div class="flex items-start space-x-3">
                <span class="text-purple-500 text-xl">📚</span>
                <div>
                  <h4 class="font-medium text-gray-900 dark:text-white">Materials</h4>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">Lecture notes and/or slides</p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <span class="text-purple-500 text-xl">📝</span>
                <div>
                  <h4 class="font-medium text-gray-900 dark:text-white">Assignments & Assessments</h4>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">A collection of practice problems and solutions</p>
                </div>
              </div>
            </div>
            <div class="space-y-4">
              <div class="flex items-start space-x-3">
                <span class="text-purple-500 text-xl">🔗</span>
                <div>
                  <h4 class="font-medium text-gray-900 dark:text-white">Resources & References</h4>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">Interactive experiences and external resources</p>
                </div>
              </div>
              <div class="flex items-start space-x-3">
                <span class="text-purple-500 text-xl">🗂️</span>
                <div>
                  <h4 class="font-medium text-gray-900 dark:text-white">Previous Editions</h4>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">Access to archived course materials</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</DocsLandingLayout>

<style>
  .container {
    max-width: 1200px;
  }
  
  /* Ensure cursive font headings display properly */
  h1 {
    line-height: 1.4;
    padding: 1rem 0;
    overflow: visible;
    min-height: 5rem;
  }
</style>