---
interface Props {
  title?: string;
  content?: string;
  items?: string[];
  variant?: 'default' | 'info' | 'tip' | 'warning';
  class?: string;
}

const { 
  title = "Summary", 
  content, 
  items = [], 
  variant = 'default',
  class: className 
} = Astro.props as Props;

const variantStyles = {
  default: 'border-border bg-background/50',
  info: 'border-blue-200 bg-blue-50/50 dark:border-blue-800 dark:bg-blue-900/20',
  tip: 'border-green-200 bg-green-50/50 dark:border-green-800 dark:bg-green-900/20',
  warning: 'border-yellow-200 bg-yellow-50/50 dark:border-yellow-800 dark:bg-yellow-900/20'
};


---

<div
  class:list={[
    className,
    "rounded-xl border p-4",
    variantStyles[variant],
    "transition-all duration-200 hover:shadow-sm"
  ]}
>
  <div class="space-y-2">
      <h3 class="text-sm font-semibold text-foreground">
        {title}
      </h3>
      
      {content && (
        <p class="text-xs text-muted-foreground leading-relaxed">
          {content}
        </p>
      )}
      
      {items.length > 0 && (
        <ul class="mt-3 space-y-1.5">
          {items.map((item) => (
            <li class="flex items-start gap-2 text-xs text-muted-foreground">
              <span class="mt-1.5 block h-1 w-1 rounded-full bg-current opacity-60 shrink-0"></span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      )}
      
      <slot />
  </div>
</div>
