---
interface Props {
  children?: any;
  icon?: string;
}

const { icon } = Astro.props;
---

<span class="marginnote-wrapper" data-note-type="marginnote">
  {icon && <span class="marginnote-icon">{icon}</span>}
  <span class="marginnote">
    <slot />
  </span>
</span>

<style>
  .marginnote-wrapper {
    position: relative;
    display: inline;
  }

  .marginnote-icon {
    color: var(--color-muted-foreground);
    font-size: 0.875rem;
    margin-right: 0.25rem;
    vertical-align: middle;
  }

  /* Mobile: Show inline with special styling */
  @media (max-width: 1280px) {
    .marginnote {
      display: block;
      background: var(--color-base-50);
      border-left: 3px solid var(--color-muted-foreground);
      padding: 0.75rem 1rem;
      margin: 0.75rem 0;
      border-radius: 0.375rem;
      font-size: 0.9em;
      line-height: 1.5;
      color: var(--color-muted-foreground);
      font-style: italic;
    }

    .dark .marginnote {
      background: var(--color-base-950);
    }
  }

  /* Desktop: Show in margin */
  @media (min-width: 1281px) {
    .marginnote {
      display: none; /* hide inline margin notes on desktop; rendered in TOC aside */
    }

    .marginnote-icon {
      display: none;
    }
  }
  
  /* For very large screens, adjust positioning */
  @media (min-width: 1536px) {
    .marginnote {
      width: 240px;
    }
  }
</style>
